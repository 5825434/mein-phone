# העתק קובץ זה ל-.env (לא נכנס ל-git) ומלא את הפרטים מפרויקט ה-Firebase שלך:
# Project Settings (⚙) → General → "Your apps" → Web app → SDK setup and configuration
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=mein-phone.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mein-phone
VITE_FIREBASE_STORAGE_BUCKET=mein-phone.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
